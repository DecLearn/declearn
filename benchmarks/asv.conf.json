{
    "version": 1,
    "project": "declearn",
    "project_url": "https://gitlab.inria.fr/magnet/declearn/declearn",
    "repo": "..",
    "branches": ["develop"],
    "environment_type": "virtualenv",
    "install_command": [
        "in-dir={env_dir} python -m pip install --quiet 'torch<=2.11' --index-url https://download.pytorch.org/whl/cu126",
        "in-dir={env_dir} python -m pip install --quiet '{build_dir}[torch,tensorflow,websockets]'"
    ],
    "matrix": {
        "asv": [""],
        "pyyaml": [""],
        "cryptography": [""]
    },
    "benchmark_dir": ".",
    "env_dir": ".asv/env",
    "results_dir": ".asv/results",
    "html_dir": ".asv/html"
}
